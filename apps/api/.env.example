# Configuration de l'API. Copier en `.env` et remplir.
# En production avec Docker, ces variables viennent de docker-compose.prod.yml
# et du fichier .env.prod — ce fichier-ci ne sert qu'en local et sur un
# hébergement classique (Laravel Forge, systemd).

# development | test | production
NODE_ENV=development
PORT=4001

DATABASE_URL=postgresql://velyna:velyna_dev@localhost:5434/velyna
# Connexions max du pool, PAR PROCESSUS. 10 pour un serveur ; 1–3 en serverless
# (Vercel), où chaque instance ouvre le sien.
DATABASE_POOL_MAX=10

# Origine EXACTE du front, sans slash final. Toute autre origine est refusée.
# ⚠️ L'API doit vivre sur un sous-domaine du même domaine que le front : le
# cookie de session est en SameSite=Lax, il ne franchit pas deux domaines
# différents et la connexion au back-office échouerait silencieusement.
CORS_ORIGIN=http://localhost:3002

# Clé de signature des jetons de session — 32 caractères minimum.
# Générer : openssl rand -base64 48
SESSION_SECRET=remplacer-par-48-octets-aleatoires-en-base64url
SESSION_HOURS=12
# Optionnel. Domaine parent pour partager le cookie entre le front et l'API
# (ex. velynaliving.com). Absent en local : le cookie reste sur l'hôte de l'API.
# SESSION_DOMAIN=velynaliving.com

# Images téléversées depuis le back-office.
# Un chemin relatif part du répertoire de LANCEMENT du processus — pratique en
# local, piégeux ailleurs.
# ⚠️ En production, l'API REFUSE de démarrer si ce chemin est relatif, ou s'il
# traverse `releases/` ou `current`. Il faut un chemin ABSOLU, persistant et
# hors du dossier de déploiement : sur un hébergement à releases atomiques
# (Laravel Forge), chaque déploiement crée un dossier neuf, et tout ce qui
# vivait dans l'ancien disparaît avec lui.
#   Forge  : UPLOAD_DIR=/home/forge/velyna-uploads   (mkdir une fois, hors du site)
#   Docker : UPLOAD_DIR=/app/apps/api/uploads        (volume `uploads` monté dessus)
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5

# Où vivent les images : `disk` (UPLOAD_DIR ci-dessus) ou `blob` (Vercel Blob,
# pour une API serverless sans disque persistant — UPLOAD_DIR est alors ignoré).
UPLOAD_STORAGE=disk
# Requis si UPLOAD_STORAGE=blob. Injecté par Vercel quand le store est connecté.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_…

# Nombre de reverse proxies devant l'API. 0 en local, 1 derrière nginx/Caddy.
# Mal réglé, la limitation des tentatives de connexion compte toutes les
# requêtes comme venant d'une seule IP.
TRUST_PROXY=0
