{
  "name": "@velyna/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d postgres",
    "db:seed": "tsx prisma/seed.ts",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "admin:create": "tsx prisma/create-admin.ts",
    "journal:seed": "tsx prisma/seed-journal.ts",
    "uploads:sweep": "tsx prisma/sweep-uploads.ts"
  },
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@velyna/shared": "workspace:*",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "typescript": "^5.9.3"
  }
}
