// Velyna Living — schéma de données
// Convention : champs en camelCase côté Prisma, colonnes en snake_case côté Postgres (@map / @@map).
// Tous les montants sont des ENTIERS en F CFA (le XOF n'a pas de décimales).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  ADMIN
  CUSTOMER
}

// Volontairement sans OUT_OF_STOCK : « épuisé » se dérive de stock = 0.
// Deux sources de vérité pour la même information finissent toujours par diverger.
enum ProductStatus {
  ONLINE
  DRAFT
}

enum JournalStatus {
  PUBLISHED
  DRAFT
}

// Les 6 statuts du design.
enum OrderStatus {
  NEW
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

// Détermine les frais : Abidjan 2 000 / Intérieur 5 000 / Retrait boutique gratuit.
enum DeliveryMethod {
  ABIDJAN
  INTERIOR
  PICKUP
}

enum Operator {
  MTN
  ORANGE
  MOOV_MONEY
  WAVE
  CARD
  CASH_ON_DELIVERY
}

// V1 : aucune intégration de paiement, tout reste en PENDING
// et l'admin confirme à la main. Les valeurs existent déjà pour la V2.
enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Origine d'un avis : déposé par le client sur le site, ou saisi dans le
// back-office (avis reçu par WhatsApp, e-mail, en boutique). Jamais public.
enum ReviewSource {
  SITE
  ADMIN
}

// Nature de la remise d'un code promo, choisie à la création.
enum PromoType {
  PERCENT // value = pourcentage (1 à 100) du sous-total
  AMOUNT // value = montant fixe en F CFA, plafonné au sous-total
  FREE_DELIVERY // value = 0 : seuls les frais de livraison sont offerts
}

// ─────────────────────────── Comptes ───────────────────────────

// V1 : sert uniquement aux comptes admin. Les clients commandent en invité.
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer Customer?

  @@map("user")
}

// Créé à la volée au moment de la commande (upsert sur l'email).
// userId est optionnel : c'est ce qui rend la commande invité possible.
model Customer {
  id        Int      @id @default(autoincrement())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  email     String   @unique
  phone     String?
  address   String?
  userId    Int?     @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User?   @relation(fields: [userId], references: [id])
  orders Order[]

  @@map("customer")
}

// ─────────────────────────── Catalogue ───────────────────────────

model House {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("house")
}

model Product {
  id       Int    @id @default(autoincrement())
  slug     String @unique
  name     String
  ref      String @unique
  houseId  Int    @map("house_id")
  price    Int
  capacity String // « 250 ml », « 50 g »
  stock    Int    @default(0)

  // Visuels. Seul le matcha renseigne imgDetail / detailBackground / inkColor.
  img              String
  imgDetail        String? @map("img_detail")
  detailBackground String? @map("detail_background")
  inkColor         String? @map("ink_color")
  // Vidéo d'ambiance de la fiche (boucle muette) : /assets/… ou /uploads/….
  video            String?

  // Notes olfactives : nullables, le matcha n'en a pas au même sens.
  headNote       String? @map("head_note")
  heartNote      String? @map("heart_note")
  backgroundNote String? @map("background_note")

  piece       String?
  usage       String? // absent du matcha dans le design
  ambiance    String?
  description String?
  newRank     Int?    @map("new_rank") // rang de nouveauté (1 = plus récent)

  status    ProductStatus @default(DRAFT)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  house      House          @relation(fields: [houseId], references: [id])
  orderItems OrderProduct[]
  reviews    Review[]

  @@index([houseId])
  @@index([status])
  @@map("product")
}

model Journal {
  id          Int           @id @default(autoincrement())
  slug        String        @unique
  title       String
  category    String?
  excerpt     String? // chapô
  body        String? // corps de l'article
  imageUrl    String?       @map("image_url")
  readingTime String?       @map("reading_time")
  views       Int           @default(0)
  publishedAt DateTime?     @map("published_at")
  status      JournalStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@map("journal")
}

// ─────────────────────────── Commandes ───────────────────────────

model Order {
  id     Int         @id @default(autoincrement())
  number String      @unique // VL-2026-XXXX, clé publique du suivi
  status OrderStatus @default(NEW)

  customerId Int @map("customer_id")

  // Coordonnées FIGÉES au moment de la commande.
  // Le client peut changer d'adresse ensuite sans réécrire l'historique.
  firstName    String  @map("first_name")
  lastName     String  @map("last_name")
  email        String
  phone        String
  address      String?
  municipality String // validé côté API contre COMMUNES_ABIDJAN (packages/shared)
  instruction  String?

  deliveryMethod DeliveryMethod @map("delivery_method")

  // Montants recalculés côté serveur, jamais reçus du client.
  subTotal     Int     @map("sub_total")
  deliveryCost Int     @map("delivery_cost")
  discount     Int     @default(0)
  // Snapshot du code saisi, affiché tel quel ; promoCodeId sert aux
  // statistiques et aux limites d'utilisation.
  promoCode    String? @map("promo_code")
  promoCodeId  Int?    @map("promo_code_id")
  total        Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer Customer       @relation(fields: [customerId], references: [id])
  promo    PromoCode?     @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  items    OrderProduct[]
  payment  Payment?
  reviews  Review[]

  @@index([customerId])
  @@index([promoCodeId])
  @@index([status])
  @@index([createdAt])
  @@map("order")
}

// Code promo événementiel (anniversaire, Noël…), créé depuis le back-office.
// Les dates sont des bornes inclusives en UTC, qui est l'heure d'Abidjan.
// Toutes les limites sont optionnelles : null = pas de limite.
model PromoCode {
  id              Int       @id @default(autoincrement())
  code            String    @unique // toujours en majuscules, immuable une fois créé
  label           String // nom de l'événement
  type            PromoType
  value           Int
  startsAt        DateTime? @map("starts_at")
  endsAt          DateTime? @map("ends_at")
  minSubTotal     Int?      @map("min_sub_total")
  maxUses         Int?      @map("max_uses")
  // Compteur décrémenté atomiquement à la commande, comme le stock, et rendu
  // quand la commande est annulée ou remboursée.
  usedCount       Int       @default(0) @map("used_count")
  oncePerCustomer Boolean   @default(false) @map("once_per_customer")
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  orders Order[]

  @@map("promo_code")
}

// Ligne de commande : document comptable figé, pas une vue sur le catalogue.
// unitPrice / productName / productRef sont copiés à l'achat pour que le
// montant d'une vieille commande ne bouge jamais.
model OrderProduct {
  orderId     Int    @map("order_id")
  productId   Int    @map("product_id")
  quantity    Int    @default(1)
  unitPrice   Int    @map("unit_price")
  productName String @map("product_name")
  productRef  String @map("product_ref")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@id([orderId, productId])
  @@index([productId])
  @@map("order_product")
}

// V1 : aucune intégration opérateur. Le client ne choisit plus de moyen de
// paiement : la boutique le rappelle, puis l'admin renseigne le moyen réel en
// encaissant. operator = null signifie « à convenir ».
model Payment {
  id        Int           @id @default(autoincrement())
  orderId   Int           @unique @map("order_id")
  operator  Operator?
  status    PaymentStatus @default(PENDING)
  amount    Int
  reference String? // référence transaction, remplie en V2
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment")
}

// Avis client, déposé depuis la fiche produit. Ouvert à tous, publié
// seulement après validation admin. `verified` n'est vrai que si le client a
// prouvé son achat (numéro de commande + e-mail d'une commande contenant le
// produit). L'e-mail ne sort jamais de l'API publique.
model Review {
  id          Int          @id @default(autoincrement())
  productId   Int          @map("product_id")
  firstName   String       @map("first_name")
  lastName    String       @map("last_name") // seule l'initiale est affichée
  email       String
  rating      Int // 1 à 5
  title       String?
  body        String
  verified    Boolean      @default(false)
  orderId     Int?         @map("order_id")
  status      ReviewStatus @default(PENDING)
  source      ReviewSource @default(SITE)
  reply       String? // réponse de la maison, publiée sous l'avis
  repliedAt   DateTime?    @map("replied_at")
  publishedAt DateTime?    @map("published_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  // Un seul avis vérifié par produit et par commande. Les avis non vérifiés
  // (orderId null) ne sont pas concernés : Postgres tient les NULL pour distincts.
  @@unique([orderId, productId])
  @@index([productId, status])
  @@index([status])
  @@map("review")
}

// Remplacements des visuels livrés avec le site (hero, blocs marques, menu…).
// Une ligne par emplacement REMPLACÉ : pas de ligne = image d'origine. Le
// catalogue des emplacements vit dans @velyna/shared (SITE_IMAGE_SLOTS), parce
// qu'un emplacement existe par le code qui l'affiche, pas par une donnée.
model SiteImage {
  key       String   @id
  path      String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_image")
}
